		<property name="com.jaspersoft.studio.data.defaultdataadapter" value="wbrm_traffic"/>
		<queryString language="SQL">
			<![CDATA[SELECT st.quantity_id || st.tariff_class as "Indice", 
sq.quantity_name as "Quantity Name", 
sq.quantity_description as "Quantity Description", 
unit_measure as "Unit of Measure", 
recurring_flag as "Recurring Flag", 
st.pricelist_name as "Pricelist Name", 
category as "Category", 
null as "validity_from", 
null as "validity_to"
FROM str_quantity sq
LEFT JOIN str_tariff st ON st.quantity_id = sq.quantity_id
WHERE st.quantity_id || st.tariff_class='QD2000'
order by st.quantity_id || st.tariff_class]]>
		</queryString>
		<field name="Indice" class="java.lang.String">
			<property name="com.jaspersoft.studio.field.label" value="Indice"/>
