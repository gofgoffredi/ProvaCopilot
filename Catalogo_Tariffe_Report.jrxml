	</subDataset>
	<queryString language="SQL">
		<![CDATA[SELECT irr.origin_dest_name || irr.term_dest_name AS "Indice",
               irr.origin_dest_name AS "Quantity ID",
               irr.term_dest_name AS "Tariff Level Class",
               to_char (irr.valid_from , 'dd/mm/yyyy') as "valid_from" ,
                        (case 
                        	when to_char (irr.valid_to , 'dd/mm/yyyy')='30/12/2299' then '31/12/2299' 
                        	when to_char (irr.valid_to , 'dd/mm/yyyy')='31/12/2999' then '31/12/2299'
                        	else to_char (irr.valid_to , 'dd/mm/yyyy')
                        end
                        ) as "valid_to",
                        irr.price AS "Price"
from billing.irt_rate_rule irr 
where irr.status ='Active'
order by  irr.origin_dest_name || irr.term_dest_name, irr.valid_to]]>
	</queryString>
