				<textFieldExpression><![CDATA[$V{TOTAL_APPROVAL}]]></textFieldExpression>
			</textField>
			<textField pattern="#,##0.00" isBlankWhenNull="true">
				<reportElement x="690" y="0" width="110" height="30" uuid="d4b2c3d4-e5f6-7890-1234-567890abcde4"/>
				<box><pen lineWidth="1.0"/></box>
				<textElement textAlignment="Right" verticalAlignment="Middle">
					<font isBold="true"/>
					<paragraph rightIndent="5"/>
