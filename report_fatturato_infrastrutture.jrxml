<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
              name="report_fatturato_infrastrutture_operatore"
              pageWidth="1800"
              pageHeight="595"
              orientation="Landscape"
              columnWidth="1780"
              leftMargin="10"
              rightMargin="10"
              topMargin="10"
              bottomMargin="10"
              uuid="a1b2c3d4-e5f6-7890-1234-567890abcdef">

    <!-- Proprietà per Excel -->
    <property name="com.jaspersoft.studio.data.defaultdataadapter" value="billing dev"/>
    <property name="net.sf.jasperreports.export.xls.ignore.graphics" value="true"/>
    <property name="net.sf.jasperreports.export.xls.remove.empty.space.between.columns" value="true"/>
    <property name="net.sf.jasperreports.export.xls.remove.empty.space.between.rows" value="true"/>
    <property name="net.sf.jasperreports.export.xls.detect.cell.type" value="true"/>

    <!-- Unico parametro per periodo di fatturazione -->
    <parameter name="BILLING_PERIOD" class="java.lang.String"/>

    <!-- Query aggiornata con estrazione START_DATE, END_DATE da BILLING_PERIOD -->
    <queryString language="SQL">
        <![CDATA[
WITH params AS (
  SELECT
    $P{BILLING_PERIOD}::text AS billing_period,
    to_date(
      '01/' ||
      CASE
        WHEN split_part($P{BILLING_PERIOD}, ' ', 1) = 'Gennaio' THEN '01'
        WHEN split_part($P{BILLING_PERIOD}, ' ', 1) = 'Febbraio' THEN '02'
        WHEN split_part($P{BILLING_PERIOD}, ' ', 1) = 'Marzo' THEN '03'
        WHEN split_part($P{BILLING_PERIOD}, ' ', 1) = 'Aprile' THEN '04'
        WHEN split_part($P{BILLING_PERIOD}, ' ', 1) = 'Maggio' THEN '05'
        WHEN split_part($P{BILLING_PERIOD}, ' ', 1) = 'Giugno' THEN '06'
        WHEN split_part($P{BILLING_PERIOD}, ' ', 1) = 'Luglio' THEN '07'
        WHEN split_part($P{BILLING_PERIOD}, ' ', 1) = 'Agosto' THEN '08'
        WHEN split_part($P{BILLING_PERIOD}, ' ', 1) = 'Settembre' THEN '09'
        WHEN split_part($P{BILLING_PERIOD}, ' ', 1) = 'Ottobre' THEN '10'
        WHEN split_part($P{BILLING_PERIOD}, ' ', 1) = 'Novembre' THEN '11'
        WHEN split_part($P{BILLING_PERIOD}, ' ', 1) = 'Dicembre' THEN '12'
      END
      || '/' || split_part($P{BILLING_PERIOD}, ' ', 2), 'DD/MM/YYYY') AS start_date
)
, bounds AS (
  SELECT
    billing_period,
    start_date,
    (start_date + INTERVAL '1 month' - INTERVAL '1 day')::date AS end_date
  FROM params
)
SELECT
    items.sr_rchead_order_no AS "Codice Pratica",
    (SELECT detail.att_value FROM STT_OBS_STATEMENT_ITEM_DETAIL detail
        WHERE detail.id = items.id AND detail.att_name = 'praticaIRP'
        LIMIT 1) AS "Codice SF",
    (SELECT detail.att_value FROM STT_OBS_STATEMENT_ITEM_DETAIL detail
        WHERE detail.id = items.id AND detail.att_name = 'dataCreazionePratica'
        LIMIT 1) AS "Data Creazione Pratica",
    NULL AS "Area Territoriale- classificazione FiberCop (Gioia)",
    (SELECT detail.att_value FROM STT_OBS_STATEMENT_ITEM_DETAIL detail
        WHERE detail.id = items.id AND detail.att_name = 'regione'
        LIMIT 1) AS "Regione",
    (SELECT detail.att_value FROM STT_OBS_STATEMENT_ITEM_DETAIL detail
        WHERE detail.id = items.id AND detail.att_name = 'provincia'
        LIMIT 1) AS "Provincia",
    (SELECT detail.att_value FROM STT_OBS_STATEMENT_ITEM_DETAIL detail
        WHERE detail.id = items.id AND detail.att_name = 'comuneTratta'
        LIMIT 1) AS "Comune",
    items.sr_rcservice_desc AS "Tipologia Infrastruttura",
    (SELECT detail.att_value FROM STT_OBS_STATEMENT_ITEM_DETAIL detail
        WHERE detail.id = items.id AND detail.att_name = 'caratterizzazione'
        LIMIT 1) AS "Caratterizzazione",
    items.sr_product_offer_name AS "Descrizione Prodotto",
    items.sr_product_price_name AS "Oggetto di Fatturazione",
    (SELECT detail.att_value FROM STT_OBS_STATEMENT_ITEM_DETAIL detail
        WHERE detail.id = items.id AND detail.att_name = 'iru'
        LIMIT 1) AS "IRU",
    items.sr_quantity AS "Quantità",
    items.multiplier AS "Numerosità",
    items.sr_product_price_code AS "Unità di Misura",
    items.sr_unit_price AS "Prezzo Unitario",
    (100 - COALESCE(items.sr_discount_percent, 0)) AS "Percentuale",
    items.sr_discounted_amount AS "Corrispettivo",
    items.product_price_extref_name AS "Listino di Riferimento",
    statement.erp_invoice_number AS "Riferimento Fattura",
    statement.erp_invoice_due_date AS "Data emissione fattura",
    bounds.billing_period AS "Periodo di Fatturazione"
FROM
    STT_OBS_STATEMENT_ITEMS items
    JOIN STT_IBS_OBS_STATEMENT statement ON statement.id = items.statement_id,
    bounds
WHERE
    items.sr_rccharge_description = 'INFRASTRUTTURE'
    AND items.status = 'Accepted by SAP'
    AND statement.erp_invoice_due_date BETWEEN bounds.start_date AND bounds.end_date;
        ]]>
    </queryString>

