<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
              name="EXCEL_REPORT_SIMPLE"
              pageWidth="842"
              pageHeight="595"
              orientation="Landscape"
              columnWidth="822"
              leftMargin="10"
              rightMargin="10"
              topMargin="10"
              bottomMargin="10"
              uuid="a1b2c3d4-e5f6-7890-1234-567890abcdef">

	<!-- Proprietà per Excel -->
	<property name="com.jaspersoft.studio.data.defaultdataadapter" value="billing dev"/>
	<property name="net.sf.jasperreports.export.xls.ignore.graphics" value="true"/>
	<property name="net.sf.jasperreports.export.xls.remove.empty.space.between.columns" value="true"/>
	<property name="net.sf.jasperreports.export.xls.remove.empty.space.between.rows" value="true"/>
	<property name="net.sf.jasperreports.export.xls.detect.cell.type" value="true"/>

	<!-- Parametro con valore di default -->
	<parameter name="STATEMENT_ID" class="java.lang.Long">
		<defaultValueExpression><![CDATA[1L]]></defaultValueExpression>
	</parameter>

	<!-- Query semplificata -->
	<queryString language="SQL">
		<![CDATA[
with items as (
    select coalesce(spd_code,'F_IFATMANFITT') spd_code,
           general_accounting_code,
           concat('Penali ',
                  case when 'N901170035' = any(array_agg(ppmi.general_accounting_code))
                       then 'Assurance'
                       else 'Provisioning'
                  end,
                  ' ',
                  array_to_string(array_agg(distinct ppmi.sr_service_type), ',')) as note
    from pnt_penalty_matched_items ppmi
    where statement_id = $P{STATEMENT_ID}
    group by spd_code, general_accounting_code
)
select erp.general_accounting_code,
       pps.ap_invoice_number,
       erp.spd_code,
       i.note,
       erp.document_amount,
       erp.approval_amount,
       abs(coalesce(erp.document_amount,0) - coalesce(erp.approval_amount, 0)) as residuo
from items i
inner join pnt_erp_commercial_approval erp on erp.spd_code = i.spd_code and erp.general_accounting_code = i.general_accounting_code
inner join pnt_penalty_statement pps on pps.id = erp.statement_id
where pps.id = $P{STATEMENT_ID}
order by pps.ap_invoice_number
		]]>
	</queryString>

	<!-- Campi della query -->
	<field name="general_accounting_code" class="java.lang.String"/>
	<field name="ap_invoice_number" class="java.lang.String"/>
	<field name="spd_code" class="java.lang.String"/>
	<field name="note" class="java.lang.String"/>
	<field name="document_amount" class="java.math.BigDecimal"/>
	<field name="approval_amount" class="java.math.BigDecimal"/>
	<field name="residuo" class="java.math.BigDecimal"/>

	<!-- Variabili per i totali -->
	<variable name="TOTAL_DOCUMENT" class="java.math.BigDecimal" calculation="Sum">
		<variableExpression><![CDATA[$F{document_amount}]]></variableExpression>
	</variable>
	<variable name="TOTAL_APPROVAL" class="java.math.BigDecimal" calculation="Sum">
		<variableExpression><![CDATA[$F{approval_amount}]]></variableExpression>
	</variable>
	<variable name="TOTAL_RESIDUO" class="java.math.BigDecimal" calculation="Sum">
		<variableExpression><![CDATA[$F{residuo}]]></variableExpression>
	</variable>

	<background>
		<band splitType="Stretch"/>
	</background>

	<!-- Intestazioni colonne -->
	<columnHeader>
		<band height="30" splitType="Stretch">
			<staticText>
				<reportElement x="0" y="0" width="120" height="30" uuid="b1b2c3d4-e5f6-7890-1234-567890abcde1"/>
				<box><pen lineWidth="1.0"/></box>
				<textElement textAlignment="Center" verticalAlignment="Middle">
					<font isBold="true"/>
				</textElement>
				<text><![CDATA[Conto N°]]></text>
			</staticText>
			<staticText>
				<reportElement x="120" y="0" width="100" height="30" uuid="b2b2c3d4-e5f6-7890-1234-567890abcde2"/>
				<box><pen lineWidth="1.0"/></box>
				<textElement textAlignment="Center" verticalAlignment="Middle">
					<font isBold="true"/>
				</textElement>
				<text><![CDATA[SPD]]></text>
			</staticText>
			<staticText>
				<reportElement x="220" y="0" width="100" height="30" uuid="b3b2c3d4-e5f6-7890-1234-567890abcde3"/>
				<box><pen lineWidth="1.0"/></box>
				<textElement textAlignment="Center" verticalAlignment="Middle">
					<font isBold="true"/>
				</textElement>
				<text><![CDATA[Fattura N°]]></text>
			</staticText>
			<staticText>
				<reportElement x="320" y="0" width="150" height="30" uuid="b4b2c3d4-e5f6-7890-1234-567890abcde4"/>
				<box><pen lineWidth="1.0"/></box>
				<textElement textAlignment="Center" verticalAlignment="Middle">
					<font isBold="true"/>
				</textElement>
				<text><![CDATA[Descrizione]]></text>
			</staticText>
			<staticText>
				<reportElement x="470" y="0" width="110" height="30" uuid="b5b2c3d4-e5f6-7890-1234-567890abcde5"/>
				<box><pen lineWidth="1.0"/></box>
				<textElement textAlignment="Center" verticalAlignment="Middle">
					<font isBold="true"/>
				</textElement>
				<text><![CDATA[Imponibile Fattura]]></text>
			</staticText>
			<staticText>
				<reportElement x="580" y="0" width="110" height="30" uuid="b6b2c3d4-e5f6-7890-1234-567890abcde6"/>
				<box><pen lineWidth="1.0"/></box>
				<textElement textAlignment="Center" verticalAlignment="Middle">
					<font isBold="true"/>
				</textElement>
				<text><![CDATA[Imponibile Benestare]]></text>
			</staticText>
			<staticText>
				<reportElement x="690" y="0" width="110" height="30" uuid="b7b2c3d4-e5f6-7890-1234-567890abcde7"/>
				<box><pen lineWidth="1.0"/></box>
				<textElement textAlignment="Center" verticalAlignment="Middle">
					<font isBold="true"/>
				</textElement>
				<text><![CDATA[Imponibile Residuo]]></text>
			</staticText>
		</band>
	</columnHeader>

	<!-- Righe dati -->
	<detail>
		<band height="20" splitType="Stretch">
			<textField isBlankWhenNull="true">
				<reportElement x="0" y="0" width="120" height="20" uuid="c1b2c3d4-e5f6-7890-1234-567890abcde1"/>
				<box><pen lineWidth="0.5"/></box>
				<textElement textAlignment="Left" verticalAlignment="Middle">
					<paragraph leftIndent="5"/>
				</textElement>
				<textFieldExpression><![CDATA[$F{general_accounting_code}]]></textFieldExpression>
			</textField>
			<textField isBlankWhenNull="true">
				<reportElement x="120" y="0" width="100" height="20" uuid="c2b2c3d4-e5f6-7890-1234-567890abcde2"/>
				<box><pen lineWidth="0.5"/></box>
				<textElement textAlignment="Left" verticalAlignment="Middle">
					<paragraph leftIndent="5"/>
				</textElement>
				<textFieldExpression><![CDATA[$F{spd_code}]]></textFieldExpression>
			</textField>
			<textField isBlankWhenNull="true">
				<reportElement x="220" y="0" width="100" height="20" uuid="c3b2c3d4-e5f6-7890-1234-567890abcde3"/>
				<box><pen lineWidth="0.5"/></box>
				<textElement textAlignment="Center" verticalAlignment="Middle"/>
				<textFieldExpression><![CDATA[$F{ap_invoice_number}]]></textFieldExpression>
			</textField>
			<textField isBlankWhenNull="true">
				<reportElement x="320" y="0" width="150" height="20" uuid="c4b2c3d4-e5f6-7890-1234-567890abcde4"/>
				<box><pen lineWidth="0.5"/></box>
				<textElement textAlignment="Left" verticalAlignment="Middle">
					<paragraph leftIndent="5"/>
				</textElement>
				<textFieldExpression><![CDATA[$F{note}]]></textFieldExpression>
			</textField>
			<textField isBlankWhenNull="true" pattern="#,##0.00">
				<reportElement x="470" y="0" width="110" height="20" uuid="c5b2c3d4-e5f6-7890-1234-567890abcde5"/>
				<box><pen lineWidth="0.5"/></box>
				<textElement textAlignment="Right" verticalAlignment="Middle">
					<paragraph rightIndent="5"/>
				</textElement>
				<textFieldExpression><![CDATA[$F{document_amount}]]></textFieldExpression>
			</textField>
			<textField isBlankWhenNull="true" pattern="#,##0.00">
				<reportElement x="580" y="0" width="110" height="20" uuid="c6b2c3d4-e5f6-7890-1234-567890abcde6"/>
				<box><pen lineWidth="0.5"/></box>
				<textElement textAlignment="Right" verticalAlignment="Middle">
					<paragraph rightIndent="5"/>
				</textElement>
				<textFieldExpression><![CDATA[$F{approval_amount}]]></textFieldExpression>
			</textField>
			<textField isBlankWhenNull="true" pattern="#,##0.00">
				<reportElement x="690" y="0" width="110" height="20" uuid="c7b2c3d4-e5f6-7890-1234-567890abcde7"/>
				<box><pen lineWidth="0.5"/></box>
				<textElement textAlignment="Right" verticalAlignment="Middle">
					<paragraph rightIndent="5"/>
				</textElement>
				<textFieldExpression><![CDATA[$F{residuo}]]></textFieldExpression>
			</textField>
		</band>
	</detail>

	<!-- Riga totali -->
	<summary>
		<band height="30" splitType="Stretch">
			<staticText>
				<reportElement x="320" y="0" width="150" height="30" uuid="d1b2c3d4-e5f6-7890-1234-567890abcde1"/>
				<box><pen lineWidth="1.0"/></box>
				<textElement textAlignment="Center" verticalAlignment="Middle">
					<font isBold="true"/>
				</textElement>
				<text><![CDATA[TOTALE]]></text>
			</staticText>
			<textField pattern="#,##0.00" isBlankWhenNull="true">
				<reportElement x="470" y="0" width="110" height="30" uuid="d2b2c3d4-e5f6-7890-1234-567890abcde2"/>
				<box><pen lineWidth="1.0"/></box>
				<textElement textAlignment="Right" verticalAlignment="Middle">
					<font isBold="true"/>
					<paragraph rightIndent="5"/>
				</textElement>
				<textFieldExpression><![CDATA[$V{TOTAL_DOCUMENT}]]></textFieldExpression>
			</textField>
			<textField pattern="#,##0.00" isBlankWhenNull="true">
				<reportElement x="580" y="0" width="110" height="30" uuid="d3b2c3d4-e5f6-7890-1234-567890abcde3"/>
				<box><pen lineWidth="1.0"/></box>
				<textElement textAlignment="Right" verticalAlignment="Middle">
