<?xml version="1.0" encoding="UTF-8"?>
<!-- Created with Jaspersoft Studio version 6.6.0.final utlizzo versione della libreria JasperReports6.6.0  -->
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="FATTURATO_REPORTS" pageWidth="1800" pageHeight="595" orientation="Landscape" whenNoDataType="AllSectionsNoDetail" columnWidth="1780" leftMargin="10" rightMargin="10" topMargin="10" bottomMargin="10" uuid="f1a5b0bc-9c12-4dca-bd3d-1c7dbe7baf92">
	<property name="com.jaspersoft.studio.data.defaultdataadapter" value="billing dev"/>
	<property name="net.sf.jasperreports.export.xls.ignore.graphics" value="true"/>
	<property name="net.sf.jasperreports.export.xls.remove.empty.space.between.columns" value="true"/>
	<property name="net.sf.jasperreports.export.xls.remove.empty.space.between.rows" value="true"/>
	<property name="net.sf.jasperreports.export.xls.detect.cell.type" value="true"/>
	<parameter name="billingPeriodIds" class="java.util.List"/>
	<parameter name="accountIds" class="java.lang.String"/>
	<queryString language="SQL">
		<![CDATA[SELECT
    items.sr_rchead_order_no AS "Codice Pratica",
    (SELECT detail.att_value FROM STT_OBS_STATEMENT_ITEM_DETAIL detail
        WHERE detail.obs_statement_item_id = items.id AND detail.att_name = 'praticaIRP' ) AS "Codice SF",
    (SELECT detail.att_value FROM STT_OBS_STATEMENT_ITEM_DETAIL detail
        WHERE detail.obs_statement_item_id = items.id AND detail.att_name = 'dataCreazionePratica') AS "Data Creazione Pratica",
    NULL AS "Area Territoriale- classificazione FiberCop (Gioia)",
    (SELECT detail.att_value FROM STT_OBS_STATEMENT_ITEM_DETAIL detail
        WHERE detail.obs_statement_item_id = items.id AND detail.att_name = 'regione') AS "Regione",
    (SELECT detail.att_value FROM STT_OBS_STATEMENT_ITEM_DETAIL detail
        WHERE detail.obs_statement_item_id = items.id AND detail.att_name = 'provincia') AS "Provincia",
    (SELECT detail.att_value FROM STT_OBS_STATEMENT_ITEM_DETAIL detail
        WHERE detail.obs_statement_item_id = items.id AND detail.att_name = 'comuneTratta') AS "Comune",
    items.sr_rcservice_desc AS "Tipologia Infrastruttura",
    (SELECT detail.att_value FROM STT_OBS_STATEMENT_ITEM_DETAIL detail
        WHERE detail.obs_statement_item_id = items.id AND detail.att_name = 'caratterizzazione') AS "Caratterizzazione",
    items.sr_product_offer_name AS "Descrizione Prodotto",
    items.sr_product_price_name AS "Oggetto di Fatturazione",
    (SELECT detail.att_value FROM STT_OBS_STATEMENT_ITEM_DETAIL detail
        WHERE detail.obs_statement_item_id = items.id AND detail.att_name = 'iru') AS "IRU",
    items.sr_quantity AS "Quantità",
    items.multiplier AS "Numerosità",
    items.sr_product_price_code AS "Unità di Misura",
    CASE
        WHEN (statement.billing_method_code = 'Credit Note')
        THEN NULL
        ELSE items.sr_unit_price
    END AS "Prezzo Unitario",
    (100 - COALESCE(items.sr_discount_percent, 0)) AS "Percentuale",
    items.sr_charge_amount AS "Corrispettivo",
    items.product_price_extref_name AS "Listino di Riferimento",
    statement.erp_invoice_number AS "Riferimento Fattura",
    statement.erp_invoice_due_date AS "Data emissione fattura",
    (
        SELECT
            CASE
                WHEN bpg_month IN ('1', '01') THEN 'Gennaio'
                WHEN bpg_month IN ('2', '02') THEN 'Febbraio'
                WHEN bpg_month IN ('3', '03') THEN 'Marzo'
                WHEN bpg_month IN ('4', '04') THEN 'Aprile'
                WHEN bpg_month IN ('5', '05') THEN 'Maggio'
                WHEN bpg_month IN ('6', '06') THEN 'Giugno'
                WHEN bpg_month IN ('7', '07') THEN 'Luglio'
                WHEN bpg_month IN ('8', '08') THEN 'Agosto'
                WHEN bpg_month IN ('9', '09') THEN 'Settembre'
                WHEN bpg_month = '10' THEN 'Ottobre'
                WHEN bpg_month = '11' THEN 'Novembre'
                WHEN bpg_month = '12' THEN 'Dicembre'
                ELSE bpg_month
            END || ' ' || bpg_year
        FROM bpt_billing_period
        WHERE id = statement.billing_period_id
        LIMIT 1
    ) AS "Periodo di Fatturazione"
FROM
    STT_OBS_STATEMENT_ITEMS items,
    STT_IBS_OBS_STATEMENT statement
WHERE
    statement.id = items.statement_id
    AND statement.product_group_code = 'INFRASTRUTTURE'
    AND statement.status = 'Accepted by SAP'
    AND statement.billing_period_id IN (
        SELECT DISTINCT id FROM bpt_billing_period bbp WHERE bbp.name IN ($P!{billingPeriodIds})
    )
    AND statement.account_id = $P{accountIds};]]>
	</queryString>
