		<variableExpression><![CDATA[Integer.valueOf(($P{ANNO_COMPETENZA_PENALE}==null)?(new SimpleDateFormat("yyyy")).format(new Date()) : $P{ANNO_COMPETENZA_PENALE}.stream().sorted(java.util.Comparator.reverseOrder()).collect(java.util.stream.Collectors.toList()).toString().substring(1,5))]]></variableExpression>
	</variable>
