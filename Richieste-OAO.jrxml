	<subDataset name="Main Query" uuid="3c0e7aa5-a012-4207-aaa6-7ce9ac4ffe17">
		<property name="com.jaspersoft.studio.data.defaultdataadapter" value="Zira Dev"/>
		<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
		<property name="com.jaspersoft.studio.data.sql.SQLQueryDesigner.sash.w1" value="0"/>
		<property name="com.jaspersoft.studio.data.sql.SQLQueryDesigner.sash.w2" value="1000"/>
		<parameter name="TYPE" class="java.util.ArrayList" nestedType="java.lang.String">
			<defaultValueExpression><![CDATA[null]]></defaultValueExpression>
		</parameter>
		<parameter name="PENALTY" class="java.util.ArrayList"/>
		<parameter name="COMPLAINT_TYPE" class="java.util.ArrayList"/>
		<parameter name="STATUS" class="java.util.ArrayList"/>
		<parameter name="SERVICE" class="java.util.ArrayList"/>
		<parameter name="FAMILY" class="java.util.ArrayList"/>
		<parameter name="CON_PENALE" class="java.util.ArrayList"/>
		<parameter name="FLAG_RICHIESTA_TECNICA" class="java.util.ArrayList"/>
		<parameter name="FLAG_PRESENZA_ACCORDO" class="java.util.ArrayList"/>
		<parameter name="ID_ACCORDO" class="java.lang.String"/>
		<parameter name="CURR_YEAR" class="java.lang.Integer"/>
		<parameter name="SCOPE" class="java.util.ArrayList"/>
		<parameter name="ACCOUNT" class="java.util.ArrayList"/>
		<queryString>
			<![CDATA[with q1 as (
select year_competence  "year", sum(total_request) richieste, exposure maturate,  sum(approved_amount) riconoscimenti, 
sum(agreement) accordi,complaint_type,
sum(total_request) - (sum(approved_amount) + sum(agreement) + sum(credit_notes)) respinto,
max(exposure) - (sum(approved_amount) + sum(agreement) + sum(credit_notes)) residuo ,
case when area='Assurance' then true else false end assurance,
case when complaint_type= 'NOTIFICHE E RIMODULAZIONI' then true else false end RITARDATA,
case when area='Provisioning' and complaint_type!='NOTIFICHE E RIMODULAZIONI' then true else false end provisioning
FROM pnt_calculated_agg_requests pcar
inner join billing.act_account aa on aa.id = pcar.account_id 
where true and aa.source_account_code NOT IN ('TIM', 'TLC')
and case when '$P!{ACCOUNT}' = 'null' then true else  pcar.account_id = any (translate('$P!{ACCOUNT}','"[]',' {}') ::text[])  end 
and $X{IN, pcar.area, TYPE}
and $X{IN, pcar.penalty_code, PENALTY}
and $X{IN, pcar.complaint_type, COMPLAINT_TYPE}
and pcar.status in ('SAP Registration')
and $X{IN, pcar.service, SERVICE}
and $X{IN, pcar.macro_service, FAMILY}
and $X{IN, pcar.penalty_in, CON_PENALE}
and $X{IN, pcar.technical_request_ind, FLAG_RICHIESTA_TECNICA}
and $X{IN, pcar.flag_agreement, FLAG_PRESENZA_ACCORDO}
and case when '$P!{ID_ACCORDO}' = 'null' then true else  $X{EQUAL, pcar.agreement_id, ID_ACCORDO} end
and $X{IN, pcar.penalty_scope, SCOPE}
and year_competence between $P{CURR_YEAR} -3 and  $P{CURR_YEAR}
GROUP BY year, pcar.account_name, PENALTY_SCOPE, PENALTY_NAME, COMPLAINT_TYPE, SERVICE, MACRO_SERVICE, 
PENALTY_IN, FLAG_AGREEMENT, AGREEMENT_ID, MONTH_COMPETENCE,  area, assurance, RITARDATA, provisioning, exposure),

years as (
	select  $P{CURR_YEAR}  y0,
	 $P{CURR_YEAR} - 1 y1,
	 $P{CURR_YEAR} -2 y2,
	 $P{CURR_YEAR} -3 y3
)

select '1.RICHIESTE' ord,

coalesce( sum(case when assurance and year=y0 then richieste else 0 end),0)assurance_y0,
coalesce( sum(case when provisioning and year=y0 then richieste else 0 end),0)provisioning_y0,
coalesce( sum(case when (assurance or provisioning) and year=y0 then richieste else 0 end),0)ass_pr_y0,
coalesce( sum(case when RITARDATA and year=y0 then richieste else 0 end),0)ritardata_y0,
coalesce( sum(case when year=y0 then richieste else 0 end),0)totali_y0,

coalesce( sum(case when assurance and year=y1 then richieste else 0 end),0)assurance_y1,
coalesce( sum(case when provisioning and year=y1 then richieste else 0 end),0)provisioning_y1,
coalesce( sum(case when (assurance or provisioning) and year=y1 then richieste else 0 end),0)ass_pr_y1,
coalesce( sum(case when RITARDATA and year=y1 then richieste else 0 end),0)ritardata_y1,
coalesce( sum(case when year=y1 then richieste else 0 end),0)totali_y1,

coalesce( sum(case when assurance and year=y2 then richieste else 0 end),0)assurance_y2,
coalesce( sum(case when provisioning and year=y2 then richieste else 0 end),0)provisioning_y2,
coalesce( sum(case when (assurance or provisioning) and year=y2 then richieste else 0 end),0)ass_pr_y2,
coalesce( sum(case when RITARDATA and year=y2 then richieste else 0 end),0)ritardata_y2,
coalesce( sum(case when year=y2 then richieste else 0 end),0)totali_y2,

coalesce( sum(case when assurance and year=y3 then richieste else 0 end),0)assurance_y3,
coalesce( sum(case when provisioning and year=y3 then richieste else 0 end),0)provisioning_y3,
coalesce( sum(case when (assurance or provisioning) and year=y3 then richieste else 0 end),0)ass_pr_y3,
coalesce( sum(case when RITARDATA and year=y3 then richieste else 0 end),0)ritardata_y3,
coalesce( sum(case when year=y3 then richieste else 0 end),0)totali_y3,

coalesce( sum(richieste), 0) totali from q1, years

union select '2.RICONOSCIMENTI' ord,

coalesce( sum(case when assurance and year=y0 then riconoscimenti else 0 end),0)assurance_y0,
coalesce( sum(case when provisioning and year=y0 then riconoscimenti else 0 end),0)provisioning_y0,
coalesce( sum(case when (assurance or provisioning) and year=y0 then riconoscimenti else 0 end),0)ass_pr_y0,
coalesce( sum(case when RITARDATA and year=y0 then riconoscimenti else 0 end),0)ritardata_y0,
coalesce( sum(case when year=y0 then riconoscimenti else 0 end),0)totali_y0,

coalesce( sum(case when assurance and year=y1 then riconoscimenti else 0 end),0)assurance_y1,
coalesce( sum(case when provisioning and year=y1 then riconoscimenti else 0 end),0)provisioning_y1,
coalesce( sum(case when (assurance or provisioning) and year=y1 then riconoscimenti else 0 end),0)ass_pr_y1,
coalesce( sum(case when RITARDATA and year=y1 then riconoscimenti else 0 end),0)ritardata_y1,
coalesce( sum(case when year=y1 then riconoscimenti else 0 end),0)totali_y1,

coalesce( sum(case when assurance and year=y2 then riconoscimenti else 0 end),0)assurance_y2,
coalesce( sum(case when provisioning and year=y2 then riconoscimenti else 0 end),0)provisioning_y2,
coalesce( sum(case when (assurance or provisioning) and year=y2 then riconoscimenti else 0 end),0)ass_pr_y2,
coalesce( sum(case when RITARDATA and year=y2 then riconoscimenti else 0 end),0)ritardata_y2,
coalesce( sum(case when year=y2 then riconoscimenti else 0 end),0)totali_y2,

coalesce( sum(case when assurance and year=y3 then riconoscimenti else 0 end),0)assurance_y3,
coalesce( sum(case when provisioning and year=y3 then riconoscimenti else 0 end),0)provisioning_y3,
coalesce( sum(case when (assurance or provisioning) and year=y3 then riconoscimenti else 0 end),0)ass_pr_y3,
coalesce( sum(case when RITARDATA and year=y3 then riconoscimenti else 0 end),0)ritardata_y3,
coalesce( sum(case when year=y3 then riconoscimenti else 0 end),0)totali_y3,

coalesce( sum(riconoscimenti) ,0) totali from q1, years

union select '3.ACCORDI' ord,

coalesce( sum(case when assurance and year=y0 then accordi else 0 end),0)assurance_y0,
coalesce( sum(case when provisioning and year=y0 then accordi else 0 end),0)provisioning_y0,
coalesce( sum(case when (assurance or provisioning) and year=y0 then accordi else 0 end),0)ass_pr_y0,
coalesce( sum(case when RITARDATA and year=y0 then accordi else 0 end),0)ritardata_y0,
coalesce( sum(case when year=y0 then accordi else 0 end),0)totali_y0,

coalesce( sum(case when assurance and year=y1 then accordi else 0 end),0)assurance_y1,
coalesce( sum(case when provisioning and year=y1 then accordi else 0 end),0)provisioning_y1,
coalesce( sum(case when (assurance or provisioning) and year=y1 then accordi else 0 end),0)ass_pr_y1,
coalesce( sum(case when RITARDATA and year=y1 then accordi else 0 end),0)ritardata_y1,
coalesce( sum(case when year=y1 then accordi else 0 end),0)totali_y1,

coalesce( sum(case when assurance and year=y2 then accordi else 0 end),0)assurance_y2,
coalesce( sum(case when provisioning and year=y2 then accordi else 0 end),0)provisioning_y2,
coalesce( sum(case when (assurance or provisioning) and year=y2 then accordi else 0 end),0)ass_pr_y2,
coalesce( sum(case when RITARDATA and year=y2 then accordi else 0 end),0)ritardata_y2,
coalesce( sum(case when year=y2 then accordi else 0 end),0)totali_y2,

coalesce( sum(case when assurance and year=y3 then accordi else 0 end),0)assurance_y3,
coalesce( sum(case when provisioning and year=y3 then accordi else 0 end),0)provisioning_y3,
coalesce( sum(case when (assurance or provisioning) and year=y3 then accordi else 0 end),0)ass_pr_y3,
coalesce( sum(case when RITARDATA and year=y3 then accordi else 0 end),0)ritardata_y3,
coalesce( sum(case when year=y3 then accordi else 0 end),0)totali_y3,

coalesce( sum(accordi) ,0) totali from q1, years


union select '4.RESPINTO' ord,

coalesce( sum(case when assurance and year=y0 then respinto else 0 end),0)assurance_y0,
coalesce( sum(case when provisioning and year=y0 then respinto else 0 end),0)provisioning_y0,
coalesce( sum(case when (assurance or provisioning) and year=y0 then respinto else 0 end),0)ass_pr_y0,
coalesce( sum(case when RITARDATA and year=y0 then respinto else 0 end),0)ritardata_y0,
coalesce( sum(case when year=y0 then respinto else 0 end),0)totali_y0,

coalesce( sum(case when assurance and year=y1 then respinto else 0 end),0)assurance_y1,
coalesce( sum(case when provisioning and year=y1 then respinto else 0 end),0)provisioning_y1,
coalesce( sum(case when (assurance or provisioning) and year=y1 then respinto else 0 end),0)ass_pr_y1,
coalesce( sum(case when RITARDATA and year=y1 then respinto else 0 end),0)ritardata_y1,
coalesce( sum(case when year=y1 then respinto else 0 end),0)totali_y1,

coalesce( sum(case when assurance and year=y2 then respinto else 0 end),0)assurance_y2,
coalesce( sum(case when provisioning and year=y2 then respinto else 0 end),0)provisioning_y2,
coalesce( sum(case when (assurance or provisioning) and year=y2 then respinto else 0 end),0)ass_pr_y2,
coalesce( sum(case when RITARDATA and year=y2 then respinto else 0 end),0)ritardata_y2,
coalesce( sum(case when year=y2 then respinto else 0 end),0)totali_y2,

coalesce( sum(case when assurance and year=y3 then respinto else 0 end),0)assurance_y3,
coalesce( sum(case when provisioning and year=y3 then respinto else 0 end),0)provisioning_y3,
coalesce( sum(case when (assurance or provisioning) and year=y3 then respinto else 0 end),0)ass_pr_y3,
coalesce( sum(case when RITARDATA and year=y3 then respinto else 0 end),0)ritardata_y3,
coalesce( sum(case when year=y3 then respinto else 0 end),0)totali_y3,

coalesce( sum(respinto) ,0) totali from q1, years

union select '5.' ord, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null

union select '5.PENALI POTENZIALI MATURATE' ord,

coalesce( sum(case when assurance and year=y0 then maturate else 0 end),0)assurance_y0,
coalesce( sum(case when provisioning and year=y0 then maturate else 0 end),0)provisioning_y0,
coalesce( sum(case when (assurance or provisioning) and year=y0 then maturate else 0 end),0)ass_pr_y0,
coalesce( sum(case when RITARDATA and year=y0 then maturate else 0 end),0)ritardata_y0,
coalesce( sum(case when year=y0 then maturate else 0 end),0)totali_y0,

coalesce( sum(case when assurance and year=y1 then maturate else 0 end),0)assurance_y1,
coalesce( sum(case when provisioning and year=y1 then maturate else 0 end),0)provisioning_y1,
coalesce( sum(case when (assurance or provisioning) and year=y1 then maturate else 0 end),0)ass_pr_y1,
coalesce( sum(case when RITARDATA and year=y1 then maturate else 0 end),0)ritardata_y1,
coalesce( sum(case when year=y1 then maturate else 0 end),0)totali_y1,

coalesce( sum(case when assurance and year=y2 then maturate else 0 end),0)assurance_y2,
coalesce( sum(case when provisioning and year=y2 then maturate else 0 end),0)provisioning_y2,
coalesce( sum(case when (assurance or provisioning) and year=y2 then maturate else 0 end),0)ass_pr_y2,
coalesce( sum(case when RITARDATA and year=y2 then maturate else 0 end),0)ritardata_y2,
coalesce( sum(case when year=y2 then maturate else 0 end),0)totali_y2,

coalesce( sum(case when assurance and year=y3 then maturate else 0 end),0)assurance_y3,
coalesce( sum(case when provisioning and year=y3 then maturate else 0 end),0)provisioning_y3,
coalesce( sum(case when (assurance or provisioning) and year=y3 then maturate else 0 end),0)ass_pr_y3,
coalesce( sum(case when RITARDATA and year=y3 then maturate else 0 end),0)ritardata_y3,
coalesce( sum(case when year=y3 then maturate else 0 end),0)totali_y3,

coalesce( sum(maturate),0) totali from q1, years


union select '6.RICONOSCIMENTI' ord,

coalesce( sum(case when assurance and year=y0 then riconoscimenti else 0 end),0)assurance_y0,
coalesce( sum(case when provisioning and year=y0 then riconoscimenti else 0 end),0)provisioning_y0,
coalesce( sum(case when (assurance or provisioning) and year=y0 then riconoscimenti else 0 end),0)ass_pr_y0,
