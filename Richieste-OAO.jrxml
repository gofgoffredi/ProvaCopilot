		<parameter name="MONTH" class="java.util.ArrayList"/>
		<queryString language="plsql">
			<![CDATA[SELECT  distinct string_agg(account_name, ', ') as account_name
FROM billing.act_account
where case when '$P!{ACCOUNT}' = 'null' then true else id = any(  translate('$P!{ACCOUNT}','[]"','{} ')::text[] ) end
order by 1]]>
		</queryString>
		<field name="account_name" class="java.lang.String">
			<property name="com.jaspersoft.studio.field.label" value="account_name"/>
		</field>
	</subDataset>
