coalesce( sum(case when year=y3 then accordi else 0 end),0)totali_y3,

coalesce( sum(accordi),0) totali from q1, years


union select '8.RESIDUO PENALI POTENZIALI' ord,

coalesce( sum(case when assurance and year=y0 then residuo else 0 end),0)assurance_y0,
coalesce( sum(case when provisioning and year=y0 then residuo else 0 end),0)provisioning_y0,
coalesce( sum(case when (assurance or provisioning) and year=y0 then residuo else 0 end),0)ass_pr_y0,
coalesce( sum(case when RITARDATA and year=y0 then residuo else 0 end),0)ritardata_y0,
coalesce( sum(case when year=y0 then residuo else 0 end),0)totali_y0,

coalesce( sum(case when assurance and year=y1 then residuo else 0 end),0)assurance_y1,
coalesce( sum(case when provisioning and year=y1 then residuo else 0 end),0)provisioning_y1,
coalesce( sum(case when (assurance or provisioning) and year=y1 then residuo else 0 end),0)ass_pr_y1,
coalesce( sum(case when RITARDATA and year=y1 then residuo else 0 end),0)ritardata_y1,
coalesce( sum(case when year=y1 then residuo else 0 end),0)totali_y1,

coalesce( sum(case when assurance and year=y2 then residuo else 0 end),0)assurance_y2,
coalesce( sum(case when provisioning and year=y2 then residuo else 0 end),0)provisioning_y2,
coalesce( sum(case when (assurance or provisioning) and year=y2 then residuo else 0 end),0)ass_pr_y2,
coalesce( sum(case when RITARDATA and year=y2 then residuo else 0 end),0)ritardata_y2,
coalesce( sum(case when year=y2 then residuo else 0 end),0)totali_y2,

coalesce( sum(case when assurance and year=y3 then residuo else 0 end),0)assurance_y3,
coalesce( sum(case when provisioning and year=y3 then residuo else 0 end),0)provisioning_y3,
coalesce( sum(case when (assurance or provisioning) and year=y3 then residuo else 0 end),0)ass_pr_y3,
coalesce( sum(case when RITARDATA and year=y3 then residuo else 0 end),0)ritardata_y3,
coalesce( sum(case when year=y3 then residuo else 0 end),0)totali_y3,

coalesce( sum(residuo),0) totali  from q1, years

order by 1]]>
		</queryString>
