	<queryString>
		<![CDATA[select coalesce(max(yy),extract(year from current_date)::int) as date_part  from 
generate_series(extract(year from current_date)::int,10,-1) yy
where yy::text =  any (translate('[$P!{ANNO_COMPETENZA_PENALE}]','"[]',' {}') ::text[])]]>
	</queryString>
	<field name="date_part" class="java.lang.Integer">
		<property name="com.jaspersoft.studio.field.label" value="date_part"/>
	</field>
