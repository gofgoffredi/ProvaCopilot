coalesce( sum(case when RITARDATA and year=y2 then riconoscimenti else 0 end),0)ritardata_y2,
coalesce( sum(case when year=y2 then riconoscimenti else 0 end),0)totali_y2,

coalesce( sum(case when assurance and year=y3 then riconoscimenti else 0 end),0)assurance_y3,
coalesce( sum(case when provisioning and year=y3 then riconoscimenti else 0 end),0)provisioning_y3,
coalesce( sum(case when (assurance or provisioning) and year=y3 then riconoscimenti else 0 end),0)ass_pr_y3,
coalesce( sum(case when RITARDATA and year=y3 then riconoscimenti else 0 end),0)ritardata_y3,
coalesce( sum(case when year=y3 then riconoscimenti else 0 end),0)totali_y3,

coalesce( sum(riconoscimenti),0) totali from q1, years

union select '7.ACCORDI' ord,

coalesce( sum(case when assurance and year=y0 then accordi else 0 end),0)assurance_y0,
coalesce( sum(case when provisioning and year=y0 then accordi else 0 end),0)provisioning_y0,
coalesce( sum(case when (assurance or provisioning) and year=y0 then accordi else 0 end),0)ass_pr_y0,
coalesce( sum(case when RITARDATA and year=y0 then accordi else 0 end),0)ritardata_y0,
coalesce( sum(case when year=y0 then accordi else 0 end),0)totali_y0,

