<!-- Created with Jaspersoft Studio version 6.6.0.final utlizzo versione della libreria JasperReports6.6.0  -->
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="report_fatturato_infrastrutture_operatore" pageWidth="1800" pageHeight="595" orientation="Landscape" columnWidth="1780" leftMargin="10" rightMargin="10" topMargin="10" bottomMargin="10" uuid="a1b2c3d4-e5f6-7890-1234-567890abcdef">
	<property name="com.jaspersoft.studio.data.defaultdataadapter" value="billing dev"/>
	<property name="net.sf.jasperreports.export.xls.ignore.graphics" value="true"/>
	<property name="net.sf.jasperreports.export.xls.remove.empty.space.between.columns" value="true"/>
	<property name="net.sf.jasperreports.export.xls.remove.empty.space.between.rows" value="true"/>
	<property name="net.sf.jasperreports.export.xls.detect.cell.type" value="true"/>
	<parameter name="BILLING_PERIOD" class="java.lang.Long"/>
	<parameter name="ACCOUNT_ID" class="java.lang.String"/>
	<queryString language="SQL">
		<![CDATA[SELECT
    items.sr_rchead_order_no AS "Codice Pratica",
    (SELECT detail.att_value FROM STT_OBS_STATEMENT_ITEM_DETAIL detail
        WHERE detail.id = items.id AND detail.att_name = 'praticaIRP'
        LIMIT 1) AS "Codice SF",
    (SELECT detail.att_value FROM STT_OBS_STATEMENT_ITEM_DETAIL detail
        WHERE detail.id = items.id AND detail.att_name = 'dataCreazionePratica'
        LIMIT 1) AS "Data Creazione Pratica",
    NULL AS "Area Territoriale- classificazione FiberCop (Gioia)",
    (SELECT detail.att_value FROM STT_OBS_STATEMENT_ITEM_DETAIL detail
        WHERE detail.id = items.id AND detail.att_name = 'regione'
        LIMIT 1) AS "Regione",
    (SELECT detail.att_value FROM STT_OBS_STATEMENT_ITEM_DETAIL detail
        WHERE detail.id = items.id AND detail.att_name = 'provincia'
        LIMIT 1) AS "Provincia",
    (SELECT detail.att_value FROM STT_OBS_STATEMENT_ITEM_DETAIL detail
        WHERE detail.id = items.id AND detail.att_name = 'comuneTratta'
        LIMIT 1) AS "Comune",
    items.sr_rcservice_desc AS "Tipologia Infrastruttura",
    (SELECT detail.att_value FROM STT_OBS_STATEMENT_ITEM_DETAIL detail
        WHERE detail.id = items.id AND detail.att_name = 'caratterizzazione'
        LIMIT 1) AS "Caratterizzazione",
    items.sr_product_offer_name AS "Descrizione Prodotto",
    items.sr_product_price_name AS "Oggetto di Fatturazione",
    (SELECT detail.att_value FROM STT_OBS_STATEMENT_ITEM_DETAIL detail
        WHERE detail.id = items.id AND detail.att_name = 'iru'
        LIMIT 1) AS "IRU",
    items.sr_quantity AS "Quantità",
    items.multiplier AS "Numerosità",
    items.sr_product_price_code AS "Unità di Misura",
    items.sr_unit_price AS "Prezzo Unitario",
    (100 - COALESCE(items.sr_discount_percent, 0)) AS "Percentuale",
    items.sr_discounted_amount AS "Corrispettivo",
    items.product_price_extref_name AS "Listino di Riferimento",
    statement.erp_invoice_number AS "Riferimento Fattura",
    statement.erp_invoice_due_date AS "Data emissione fattura",
    $P{BILLING_PERIOD} AS "Periodo di Fatturazione"
FROM
    STT_OBS_STATEMENT_ITEMS items
    JOIN STT_IBS_OBS_STATEMENT statement ON statement.id = items.statement_id
WHERE
    items.sr_rccharge_description = 'INFRASTRUTTURE'
    AND items.status = 'Approved'
    AND items.billing_period_id = $P{BILLING_PERIOD}
    AND items.account_id = $P{ACCOUNT_ID};]]>
	</queryString>
