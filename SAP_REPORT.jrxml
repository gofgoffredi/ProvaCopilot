	<subDataset name="Dataset1" uuid="d200c2c1-5624-414f-815a-6678d63dbd30">
		<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
		<property name="com.jaspersoft.studio.data.defaultdataadapter" value="timce.xml"/>
		<property name="com.jaspersoft.studio.data.sql.SQLQueryDesigner.sash.w1" value="316"/>
		<property name="com.jaspersoft.studio.data.sql.SQLQueryDesigner.sash.w2" value="679"/>
		<parameter name="STATEMENT_ID" class="java.lang.Long"/>
		<queryString language="SQL">
			<![CDATA[with items as (    select coalesce(spd_code,'F_IFATMANFITT') spd_code, general_accounting_code, concat('Penali ',    case when 'N901170035' = any(array_agg(ppmi.general_accounting_code)) then 'Assurance' else 'Provisioning' end,    ' ', array_to_string(array_agg(distinct ppmi.sr_service_type), ',')) as note 
    from pnt_penalty_matched_items ppmi 
    where statement_id = $P{STATEMENT_ID} group by spd_code, general_accounting_code
 ) select erp.general_accounting_code, pps.ap_invoice_number, erp.spd_code, i.note, erp.document_amount, erp.approval_amount, abs(coalesce(erp.document_amount,0) - coalesce(erp.approval_amount, 0)) as residuo, erp.residual_amount
 from items i
 inner join pnt_erp_commercial_approval erp on erp.spd_code = i.spd_code and erp.general_accounting_code = i.general_accounting_code
 inner join pnt_penalty_statement pps on pps.id = erp.statement_id 
 where pps.id = $P{STATEMENT_ID} order by pps.ap_invoice_number]]>
		</queryString>
		<field name="general_accounting_code" class="java.lang.String">
			<property name="com.jaspersoft.studio.field.label" value="general_accounting_code"/>
			<property name="com.jaspersoft.studio.field.tree.path" value="pnt_erp_commercial_approval"/>
		</field>
		<field name="ap_invoice_number" class="java.lang.String">
			<property name="com.jaspersoft.studio.field.label" value="ap_invoice_number"/>
			<property name="com.jaspersoft.studio.field.tree.path" value="pnt_penalty_statement"/>
		</field>
		<field name="spd_code" class="java.lang.String">
			<property name="com.jaspersoft.studio.field.label" value="spd_code"/>
		</field>
		<field name="note" class="java.lang.String">
			<property name="com.jaspersoft.studio.field.label" value="note"/>
		</field>
		<field name="document_amount" class="java.math.BigDecimal">
			<property name="com.jaspersoft.studio.field.label" value="document_amount"/>
			<property name="com.jaspersoft.studio.field.tree.path" value="pnt_erp_commercial_approval"/>
		</field>
		<field name="approval_amount" class="java.math.BigDecimal">
			<property name="com.jaspersoft.studio.field.label" value="approval_amount"/>
			<property name="com.jaspersoft.studio.field.tree.path" value="pnt_erp_commercial_approval"/>
		</field>
		<field name="residuo" class="java.math.BigDecimal">
			<property name="com.jaspersoft.studio.field.label" value="residuo"/>
		</field>
		<field name="residual_amount" class="java.math.BigDecimal">
			<property name="com.jaspersoft.studio.field.label" value="residual_amount"/>
			<property name="com.jaspersoft.studio.field.tree.path" value="pnt_erp_commercial_approval"/>
		</field>
		<variable name="SUM_DOCUMENT_AMOUNT" class="java.math.BigDecimal" calculation="Sum">
			<variableExpression><![CDATA[$F{document_amount}]]></variableExpression>
		</variable>
		<variable name="SUM_APPROVAL_AMOUNT" class="java.math.BigDecimal" calculation="Sum">
