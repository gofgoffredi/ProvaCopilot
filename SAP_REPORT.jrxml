	<queryString>
		<![CDATA[select st.sr_issue_date, acc.account_name, erp.general_accounting_code, erp.accounting_sector , erp.cost_center
from pnt_penalty_statement st, act_account acc, pnt_erp_commercial_approval erp
where st.id = $P{STATEMENT_ID}   and st.account_id = acc.id and erp.statement_id = st.id limit 1]]>
	</queryString>
