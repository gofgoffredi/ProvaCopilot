		</variable>
		<variable name="SUM_RESIDUAL_AMOUNT" class="java.math.BigDecimal" calculation="Sum">
			<variableExpression><![CDATA[$F{residuo}]]></variableExpression>
		</variable>
	</subDataset>
	<parameter name="STATEMENT_ID" class="java.lang.Long"/>
