<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="Storico" pageWidth="5881" pageHeight="842" whenNoDataType="AllSectionsNoDetail" columnWidth="4960" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" isIgnorePagination="true" uuid="e1201b77-75f9-470e-8eed-2adc93f74b3c">
	<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
	<property name="net.sf.jasperreports.export.xls.detect.cell.type" value="true"/>
	<property name="com.jaspersoft.studio.data.defaultdataadapter" value="One Empty Record"/>
	<property name="net.sf.jasperreports.export.xls.sheet.names.1" value="RIPARTIZIONI"/>
	<property name="net.sf.jasperreports.export.xls.one.page.per.sheet" value="true"/>
	<property name="net.sf.jasperreports.page.break.no.pagination" value="apply"/>
	<subDataset name="Tabel1" uuid="1f56051c-f7b3-4389-add1-847e48b9062e">
		<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
		<property name="com.jaspersoft.studio.data.sql.SQLQueryDesigner.sash.w1" value="290"/>
		<property name="com.jaspersoft.studio.data.sql.SQLQueryDesigner.sash.w2" value="705"/>
		<property name="com.jaspersoft.studio.data.defaultdataadapter" value="billing"/>
		<parameter name="month" class="java.lang.String"/>
		<parameter name="year" class="java.lang.String"/>
		<parameter name="yearFrom" class="java.lang.String"/>
		<parameter name="yearTo" class="java.lang.String"/>
		<parameter name="monthFrom" class="java.lang.String"/>
		<parameter name="monthTo" class="java.lang.String"/>
		<parameter name="accountIds" class="java.util.ArrayList"/>
		<queryString>
			<![CDATA[select distinct child.id, case when child.type = 'Posizione' then parent.dispute_number
	when child.type = 'Contestazione' then child.dispute_number 
	else null end as "ID Contestazione",
	case when child.type = 'Posizione' then child.dispute_number
	when child.type = 'Contestazione' then null
	else null end as "ID Posizione",
	'Attivo' as "Tipologia" , 
	child."type" as "Livello",
	case when child.source_system_code = 'SAP-DM' then 'X' else null end as "Migrazione",
	child.old_dispute_ind as "Reclamo Old",
	aa.erp_vendor_id as "Cliente",
	aa.account_name as "Descrizione Cliente",
	child.protocol  as "Numero Protocollo Interno",
	child.received_registered_mail  as "Numero Raccomandata Ricevuta",
	child.sent_registered_mail  as "Numero Raccomandata Inviata",
	case when ddh.modified_by = 'GRAVEYARD' then 'X'
	else ''
	end as "Chiusura per AC",
	dw.name as "Portafoglio",
	dw.description as "Descrizione Portafoglio",
	case when child.market_segment_code = 'RC' then '01' when child.market_segment_code = 'TRAFFIC' then '02' else null end as "Suddivisione Tecnica",
	case when child.market_segment_code = 'RC' then 'Canoni e Contributi' when child.market_segment_code = 'TRAFFIC' then 'Traffico' else null end as "Descriz. Sudd. Tecnica",
	child.product_group_code as "Descrizione Servizio",
	child.source_system_code as "Origine",
	child.input_channel_code as "Canale ricezione",
	child.status as "Descrizione Stato",
	child.erp_invoice_number as "Numero Fattura",
	SUBSTRING(child.erp_invoice_number, 1, 4) as "Società",
	SUBSTRING(child.erp_invoice_number, 5, 4) as "Esercizio",
	SUBSTRING(child.erp_invoice_number, 9, 1000) as "Progressivo Fattura",
	child.priority_code as "Priorita",
	pt.description as "Descr. Priorita",
	dw.responsible_by_desc as "Gestore",
	de.receivers_cc as "Mail in conoscenza",
	child.result as "Esito",
	child.reason_id::TEXT as "Causale Ammissibilità",
	dr.display_name as "Desc Causale Ammissibilità",
	child.inammissibility_reason as "Causale Inammissibilità",
	child.revenue_type_code as "Tipo Fatturazione",
	child.dispute_type_code as "Tipo Posizione",
	child.description as "Desc Tipo Posiz",
	'' as "Stato Precedente",
	case when ddh.modified_by = 'GRAVEYARD' then 'X'
	else ''
	end as "Pos.chiusa per AC",
	'' as "Comparto",
	child.created_by as "Eseguito da",
	ddag.assigned_team_code as "Richiesta ingaggio a",
	TO_CHAR(child.dispute_reception_date, 'DD/MM/YYYY') as "Data Raccomandata Ricevuta",
	child.sent_registered_mail as "Data Raccomandata Inviata",
	stt.sr_amount as "Imponibile fattura",
	case when child.type = 'Posizione' then parent.original_disputed_amount
	when child.type = 'Contestazione' then child.original_disputed_amount
	else null end as "Importo Reclamato OAO",
	child.original_disputed_amount as "Importo Reclamato OAO Posizioni",
	ddh.total_accepted_amount  as "Importo riconosciuto",
	 ddh.total_rejected_amount as "Importo Respinto",
	 child.original_disputed_amount - (ddh.total_accepted_amount+ ddh.total_rejected_amount) as "Residuo",
	 TO_CHAR(child.dispute_created_date, 'DD/MM/YYYY') as "Data Inserimento",
	 case when child.type = 'Posizione' then TO_CHAR(sios.sr_issue_date, 'DD/MM/YYYY')
	 else null end as "Data Emissione Fattura",
	 TO_CHAR(child.dispute_reception_date, 'DD/MM/YYYY') as "Data ricezione",
	 TO_CHAR(ddh.closed_date, 'DD/MM/YYYY') as "Data chiusura",
	 TO_CHAR(child.foreseen_closure_date, 'DD/MM/YYYY') as "Data chiusura prevista",
	 cn_item_sums."Importo Totale NC",
CASE
            WHEN ddh.status <> 'Closed' THEN CONCAT(EXTRACT(DAY FROM (LOCALTIMESTAMP - ddh.dispute_created_date)), ' days')
            WHEN ddh.status = 'Closed' THEN CONCAT(EXTRACT(DAY FROM (ddh.closed_date - ddh.dispute_created_date)), ' days')
            ELSE NULL
end as "Giacenza Testata", 
CASE
            WHEN ddh.status <> 'Closed' THEN CONCAT(EXTRACT(DAY FROM (LOCALTIMESTAMP - ddh.dispute_created_date)), ' days')
            WHEN ddh.status = 'Closed' THEN CONCAT(EXTRACT(DAY FROM (ddh.closed_date - ddh.dispute_created_date)), ' days')
            ELSE NULL
end as "Giacenza Posizione",
case
	when child.status = 'In Reconciliation' and ddh.modified is not null then CONCAT(extract (day from (localtimestamp - ddh.modified)), ' days')
	when child.status = 'In Reconciliation' and ddh.modified is null then CONCAT(extract (day from (localtimestamp - ddh.created)), ' days')
	when child.status <> 'In Reconciliation' and child.modified is not null then CONCAT(extract (day from (localtimestamp - child.modified)), ' days')
	when child.status <> 'In Reconciliation' and child.modified is null then CONCAT (extract (day from (localtimestamp - child.created)), ' days')
	else null
end as "Giacenza Stato Storico"
FROM dmt_load_dispute_head AS child 
left JOIN dmt_load_dispute_head AS parent ON parent.ID = child.parent_head_id 
left JOIN act_account aa ON child.account_id = aa.id 
left JOIN dmr_dispute_priority pt ON child.priority_code  = pt.code
left JOIN dmt_dispute_head ddh ON child.ID = ddh.load_dispute_head_id
left join dmr_wallet dw on dw.id::text = child.wallet_id
left join dmt_dispute_assignment_group ddag on ddag.dispute_head_id = ddh.id
left join stt_ibs_obs_statement sios on 
case when child.type = 'Posizione' and child.statement_id = sios.id then 1
when child.type = 'Contestazione' and exists (select 1 from dmt_load_dispute_head dldh where dldh.parent_head_id = child.id and dldh.statement_id = sios.id) then 1
else 0
end = 1
left join bpt_billing_period bbp on sios.billing_period_id =bbp.id
left join stt_ibs_obs_statement_summary stt on child.statement_id = stt.statement_id
left join (select ddi.dispute_head_id, sum(dcni.sr_amount) "Importo Totale NC" from dmt_dispute_item ddi
join dmt_credit_note_item dcni on dcni.original_Statement_item_id = ddi.statement_item_id and dcni.original_statement_id = ddi.statement_id where ($X{IN, ddi.account_id, accountIds}) and ddi.version = 1 group by ddi.dispute_head_id) cn_item_sums 
on cn_item_sums.dispute_head_id = ddh.id
left join dmt_email de on de.request_id = child.request_id and de.action_type = 'Dispute Request Creation'
left join dmr_reason dr on dr.id = child.reason_id
where
($X{IN, child.account_id, accountIds})
    AND (
        (
            $P{month} IS NOT NULL AND
            $P{year} IS NOT NULL AND
            EXTRACT(MONTH FROM bbp.start_date) = CAST($P{month} AS INTEGER) AND
            EXTRACT(YEAR FROM bbp.start_date) = CAST($P{year} AS INTEGER)
        ) OR
        (
            $P{monthFrom} IS NOT NULL AND
            $P{yearFrom} IS NOT NULL AND
            (
                bbp.start_date >= MAKE_DATE(CAST($P{yearFrom} AS INTEGER), CAST($P{monthFrom} AS INTEGER), 1) AND
                (
                    $P{monthTo} IS NULL OR
                    $P{yearTo} IS NULL OR
                    bbp.start_date <= MAKE_DATE(CAST($P{yearTo} AS INTEGER), CAST($P{monthTo} AS INTEGER), 1) + INTERVAL '1 MONTH' - INTERVAL '1 DAY'
                )
            )
        ) OR
        (
            $P{month} IS NULL AND
            $P{year} IS NULL AND
            $P{monthFrom} IS NULL AND
            $P{yearFrom} IS NULL and
            $P{monthTo} IS not NULL and
            $P{yearTo} IS not NULL and
            bbp.start_date <= MAKE_DATE(CAST($P{yearTo} AS INTEGER), CAST($P{monthTo} AS INTEGER), 1) + INTERVAL '1 MONTH' - INTERVAL '1 DAY'
        ) or 
        ($P{month} IS NULL AND
            $P{year} IS NULL AND
            $P{monthFrom} IS NULL AND
            $P{yearFrom} IS NULL and
            $P{monthTo} IS NULL and
            $P{yearTo} IS NULL)
    )
order by child.id desc;]]>
		</queryString>
